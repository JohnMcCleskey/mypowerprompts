# Public site URL used in canonical links and Open Graph tags.
# Optional. Defaults to https://mypowerprompts.com
NEXT_PUBLIC_SITE_URL=https://mypowerprompts.com

# Optional "Say thanks" link. The header and footer button is hidden when this
# is empty. No payment code ships with the site. Set this before building;
# Next inlines NEXT_PUBLIC_ values at build time.
# Example: https://github.com/sponsors/your-name
NEXT_PUBLIC_DONATION_URL=
